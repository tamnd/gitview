{{define "content"}}
<div class="repo-head">
  {{template "branchpicker" .}}
  {{template "crumbline" .}}
  <div class="repo-head-actions">
    <a class="btn" href="{{.Page.Repo.FindURL}}" data-hotkey="t">{{octicon "search"}} Go to file</a>
  </div>
</div>

<div class="Box blob-box">
  <div class="Box-header blob-header">
    <div class="blob-meta">
      <strong class="blob-name">{{.Name}}</strong>
      {{- with .Viewer}}{{with .Info}}<span class="blob-info">{{.}}</span>{{end}}{{end}}
      <span class="blob-info">{{bytesize .Size}}</span>
    </div>
    <div class="blob-actions">
      {{- if .Toggle}}
      <div class="segmented">
        <a class="segmented-item{{if not .Plain}} selected{{end}}" href="{{.RichURL}}">Preview</a>
        <a class="segmented-item{{if .Plain}} selected{{end}}" href="{{.PlainURL}}">Code</a>
      </div>
      {{- end}}
      <a class="btn btn-sm" href="{{.RawURL}}">Raw</a>
      {{- if .ShowBlame}}
      <a class="btn btn-sm" href="{{.BlameURL}}" data-hotkey="b">Blame</a>
      {{- end}}
      <a class="btn btn-sm" href="{{.HistURL}}">History</a>
      {{- if .CanCopy}}
      <button class="btn btn-sm js-copy" type="button" data-copy-target="blob" aria-label="Copy raw content">{{octicon "copy"}}</button>
      {{- end}}
    </div>
  </div>

  {{- if eq .Kind "symlink"}}
  <div class="blob-notice"><p class="text-muted">symbolic link to {{.Target}}</p></div>
  {{- else if eq .Kind "lfs"}}
  <div class="blob-notice">
    <p>{{octicon "file"}}</p>
    <p><strong>Stored with Git LFS</strong></p>
    <p class="text-muted">{{bytesize .Size}} · oid {{.OID}}</p>
  </div>
  {{- else if eq .Kind "toobig"}}
  <div class="blob-notice">
    <p><strong>Sorry about that, but we can’t show files that are this big right now.</strong></p>
    <p><a href="{{.RawURL}}">View raw</a></p>
  </div>
  {{- else if eq .Kind "binary"}}
  <div class="blob-notice">
    <p><strong>This file is binary.</strong></p>
    <p><a href="{{.RawURL}}">View raw</a></p>
  </div>
  {{- else if eq .Kind "empty"}}
  <div class="blob-notice"><p class="text-muted">This file is empty.</p></div>
  {{- else}}
  {{- with .Viewer.Note}}
  <div class="blob-note">{{.}}</div>
  {{- end}}
  {{.Viewer.Body}}
  {{- end}}
</div>
{{end}}
